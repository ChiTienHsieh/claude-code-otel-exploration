# Claude Code OTEL Verification - Environment Variables
# 複製這個檔案為 .env 並填入你的設定
#
# cp .env.example .env

# ============================================
# 必填：Anthropic API Key
# ============================================
# 取得方式: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ============================================
# Claude Code OTEL 設定
# ============================================
# 這些是你要在執行 Claude Code 時設定的環境變數
# 複製到你的 shell 或 .zshrc / .bashrc

# 啟用 telemetry (必須)
CLAUDE_CODE_ENABLE_TELEMETRY=1

# OTLP 設定 - 指向本地 collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# 或者用 HTTP (擇一)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ============================================
# 可選：Privacy 控制
# ============================================
# 預設都是 false（不記錄敏感內容）

# 記錄 user prompts（注意隱私！）
# OTEL_LOG_USER_PROMPTS=false

# 記錄 tool 輸出內容
# OTEL_LOG_TOOL_CONTENT=false

# ============================================
# 可選：Resource Attributes
# ============================================
# 加入額外標籤方便過濾

# OTEL_RESOURCE_ATTRIBUTES=department=engineering,team=platform,env=verification

# ============================================
# 可選：Debug 模式
# ============================================
# 同時輸出到 console（除錯用）

# OTEL_TRACES_EXPORTER=otlp,console
# OTEL_METRICS_EXPORTER=otlp,console
# OTEL_LOGS_EXPORTER=otlp,console
